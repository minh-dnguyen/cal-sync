FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# The -B / --beat flag embeds the scheduler into the worker process
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--beat", "--loglevel=info", "--concurrency=2", "--schedule=/tmp/celerybeat-schedule"]
