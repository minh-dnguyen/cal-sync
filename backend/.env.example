# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/calsync
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGINS=https://your-frontend.vercel.app

# ── Redis (Celery broker + slowapi rate limiting) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Google Calendar OAuth (Phase 3) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-frontend.vercel.app/auth/google/callback

# ── Microsoft Outlook OAuth (Phase 4) ─────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://your-frontend.vercel.app/auth/outlook/callback

# ── Email reminders (Phase 4) ─────────────────────────────────────────────────
# Gmail: enable 2FA, create an App Password, use that as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@calsync.app
